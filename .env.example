# ==============================================================
# STYLISTE - FULLSTACK PRODUCTION ENVIRONMENT VARIABLES (.env)
# Copy this file to .env on your deployment server and configure
# ==============================================================

# --------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# --------------------------------------------------------------
PORT=8010
SPRING_PROFILES_ACTIVE=prod
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_STYLISTE=INFO
LOGGING_LEVEL_SECURITY=INFO

# --------------------------------------------------------------
# 2. DATABASE CREDENTIALS (DEPLOYMENT MYSQL)
# --------------------------------------------------------------
# Default deployment credentials: stylist_user / stylist@321
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/styliste_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=stylist_user
SPRING_DATASOURCE_PASSWORD=stylist@321

# Connection pool limits
HIKARI_MAX_POOL_SIZE=15
HIKARI_MIN_IDLE=5

# Hibernate DDL Mode ('update' to maintain schema, or 'validate' for strict DB)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SQL_INIT_MODE=never

